{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/arte/:path*",
      "destination": "https://ia.artefinal.app/arte/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/artigos",
      "destination": "/artigos/index.html"
    },
    {
      "source": "/artigos/:slug",
      "destination": "/artigos/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
